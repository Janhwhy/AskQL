# Data generation is fully simulated (ingestion/simulate.py), no external
# APIs are called for that part. The old real-data ingestion (GitHub/npm/
# PyPI/HN) was deleted at the Phase 1->pivot boundary.

# Phase 3 agent: Gemini is the primary SQL-generation model, with a local
# Ollama model as automatic fallback on any Gemini failure (missing key,
# network error, quota, blocked API). Get a key at aistudio.google.com/apikey
# — make sure the Generative Language API is enabled for that key's Google
# Cloud project, or every call falls through to Ollama.
GEMINI_API_KEY=

# Local Ollama model used as fallback. Must already be pulled (`ollama pull
# <model>`) and the Ollama app/service running on OLLAMA_HOST.
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://localhost:11434
