# Not required for the current pipeline — data is fully simulated
# (ingestion/simulate.py), no external APIs called. Kept only because the
# real-data ingestion code (ingestion/sources/) is parked, not deleted, in
# case a real-data integration happens later.

# GitHub personal access token — raises the unauthenticated 60 req/hr limit to 5,000/hr.
# Settings → Developer settings → Personal access tokens. No scopes needed for public repo reads.
GITHUB_TOKEN=

# Optional: classic PAT (ghp_...), only used as a fallback for endpoints that
# reject fine-grained tokens. As of 2026-09, GitHub blocks /stargazers and
# /subscribers for every token type we tested — this doesn't fix that, kept
# for any other endpoint that turns out to be fine-grained-specific.
GITHUB_CLASSIC_TOKEN=

# How often the (parked) real-data scheduler polled all sources, in seconds.
POLL_INTERVAL_SECONDS=
